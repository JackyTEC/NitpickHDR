#include <windows.h>
#include <winver.h>
#include "version.h"
#include "../src/resource.h"

IDI_APP ICON "app.ico"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION NITPICK_VERSION_MAJOR,NITPICK_VERSION_MINOR,NITPICK_VERSION_PATCH,0
 PRODUCTVERSION NITPICK_VERSION_MAJOR,NITPICK_VERSION_MINOR,NITPICK_VERSION_PATCH,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Nitpick - per-monitor HDR"
            VALUE "FileVersion", NITPICK_VERSION_STR
            VALUE "InternalName", "NitpickHDR"
            VALUE "LegalCopyright", "AGPL-3.0-or-later. Based on HDRTray (Frank Richter) and HDRToggler (GiulioSamp)"
            VALUE "OriginalFilename", "NitpickHDR.exe"
            VALUE "ProductName", "Nitpick"
            VALUE "ProductVersion", NITPICK_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
